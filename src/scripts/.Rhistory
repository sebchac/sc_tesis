filter(country == "Brazil") %>%
mutate(gdd_brazil_ym = gdd_ymc,
gdd_brazil_y = gdd_yc) %>%
distinct(year, month_num, gdd_brazil_ym, gdd_brazil_y)
aux2 <- merge2 %>%
filter(country == "Colombia") %>%
