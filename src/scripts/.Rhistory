aa_c <- aa_yc %>%
group_by(country) %>%
summarise(
strategic_prop = mean(strategic_prop, na.rn = TRUE),
diff_heat_nivel = mean(diff_heat_nivel, na.rm = TRUE),
diff_costs_nivel = mean(diff_costs_nivel, na.rm = TRUE),
