model_iv2 <- ivreg(price_ym ~ qe_ym + importGDP_ym + teaPrices_ym |
farm_prices_ym +
importGDP_ym + teaPrices_ym,
data = demand_data)
# Resumen del modelo
summary(model_iv2, diagnostics = TRUE,
vcov = vcovCL, cluster = demand_data$year)
coeff <- coef(model_iv2)
# Calculate fitted values and elasticity
demand_data$qdemand_fitted_ym <- predict(model_iv2)
demand_data$edemand_ym <- (1/coeff["qe_ym"])*(demand_data$price_ym/demand_data$qe_ym)
mean_elast <- mean(demand_data$edemand_ym, na.rm = TRUE)
aux_data <- demand_data %>%
select(year, month_num, qdemand_fitted_ym, edemand_ym)
data_ymc <- left_join(data, aux_data, by = c("year", "month_num"))
data_ymc <- data_ymc %>%
filter(export_dummy == 1) %>%
mutate(mr_ymc = price_ym + coeff["qe_ym"] * qe_ymc,
mr_ymc2 = price_ym * (1 + share_ymce/mean_elast),
mr_ymc3 = (price_ym + coeff["qe_ym"] * qe_ymc * (1 / (1 + n_follower_ym))) * dummy_leader + (price_ym + coeff["qe_ym"] * qe_ymc) * dummy_follower,
lag12_gdd_ymc = lag(gdd_ymc, 12),
lag12_hdd_ymc = lag(hdd_ymc, 12),
lag12_fdd_ymc = lag(fdd_ymc, 12),
lag24_gdd_ymc = lag(gdd_ymc, 24),
lag24_hdd_ymc = lag(hdd_ymc, 24),
lag24_fdd_ymc = lag(fdd_ymc, 24),
lag48_gdd_ymc = lag(gdd_ymc, 48),
lag48_hdd_ymc = lag(hdd_ymc, 48),
lag48_fdd_ymc = lag(fdd_ymc, 48),
lag12_tas_ymc = lag(tas_ymc, 12),
lag24_tas_ymc = lag(tas_ymc, 24),
lag36_tas_ymc = lag(tas_ymc, 36))
model_interact <- feols(
mr_ymc3 ~ farm_prices_ymc + fert_ym + lag12_tas_ymc + lag12_gdd_ymc | country + year,
data = data_ymc,
cluster = ~country
)
summary(model_interact)
model_interact <- feols(
mr_ymc3 ~ farm_prices_ymc + fert_ym + lag12_tas_ymc | country + year,
data = data_ymc,
cluster = ~country
)
summary(model_interact)
model_interact <- feols(
mr_ymc3 ~ farm_prices_ymc + fert_ym + lag12_gdd_ymc | country + year,
data = data_ymc,
cluster = ~country
)
summary(model_interact)
model_interact <- feols(
mr_ymc3 ~ farm_prices_ymc + fert_ym + gdd_ymc | country + year,
data = data_ymc,
cluster = ~country
)
summary(model_interact)
