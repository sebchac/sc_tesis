efficiency_effect = sum(efficiency_effect, na.rm = TRUE),
strategic_effect = sum(strategic_effect, na.rm = TRUE),
efficiency_prop = sum(efficiency_effect / total_effect, 4),
.groups = 'drop'
) %>%
ungroup()
View(descomp_g)
decomp_long <- descomp_g %>%
mutate(
