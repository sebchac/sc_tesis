tmax_yme + tmin_yme
#lag3_tmax_yme + lag3_tmin_yme +
importGDP_ym + teaPrices_ym,
iv3 <- ivreg(price_ym ~ qe_ym  + importGDP_ym + teaPrices_ym |
#tas_yme + gdd_ym +
tmax_yme + tmin_yme +
#lag3_tmax_yme + lag3_tmin_yme +
importGDP_ym + teaPrices_ym,
data = demand_data)
summary(iv3)
iv3 <- ivreg(price_ym ~ qe_ym  + importGDP_ym + teaPrices_ym |
#tas_yme + gdd_ym +
#tmax_yme + tmin_yme +
lag3_tmax_yme + lag3_tmin_yme +
importGDP_ym + teaPrices_ym,
data = demand_data)
