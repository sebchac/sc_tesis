group_by(year) %>%
mutate(
fdd_leaders_y = mean(fdd_leaders_y, na.rm = TRUE),
fdd_followers_y = mean(fdd_followers_y, na.rm = TRUE)) %>%
ungroup()
saveRDS(merge2, file = "/Users/sebastianchacon/Desktop/sc_tesis/bld/data/data.rds")
