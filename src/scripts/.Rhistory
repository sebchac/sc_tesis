diff_costs_rivals = costs_rivals_CF0 - costs_rivals_CF1,
i_costs_CF0 = -costs_CF0 + costs_rivals_CF0,
i_costs_CF1 = -costs_CF1 + costs_rivals_CF1,
i_costs_diff = i_costs_CF0 - i_costs_CF1
)
