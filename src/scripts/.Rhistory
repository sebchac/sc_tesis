# [6] Analyze and Visualize Results
# ------------------------------------------------------------------------------
# Summary statistics by scenario
summary_ym <- all_results_ym %>%
group_by(scenario) %>%
summarise(
avg_price = mean(price, na.rm = TRUE),
quantity = sum(Q_total, na.rm = TRUE),
